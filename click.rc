// Version info and manifest: what Windows and antivirus tools expect to find
// in a normal desktop app.
#include <winver.h>
1 24 "click.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "cko"
      VALUE "FileDescription",  "click - minimal auto clicker"
      VALUE "FileVersion",      "1.0.0"
      VALUE "InternalName",     "click"
      VALUE "LegalCopyright",   "Copyright (c) 2026 cko. MIT License."
      VALUE "OriginalFilename", "click.exe"
      VALUE "ProductName",      "click"
      VALUE "ProductVersion",   "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
